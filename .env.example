# Copy this file to .env.local for local development, and add the same
# variables in Vercel (Project Settings > Environment Variables) for deployment.
# Do NOT prefix these with VITE_ or the keys will be exposed in the browser.

# Groq (primary). Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Comma-separated list; later models are tried if earlier ones are rate-limited.
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Google Gemini (fallback). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated list; later models are tried if earlier ones are rate-limited.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
