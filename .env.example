# Copy this file to .env.local for local development, and add the same
# variables in Vercel (Project Settings > Environment Variables) for deployment.
# Do NOT prefix these with VITE_ or the keys will be exposed in the browser.

# Google Gemini (primary). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated list; later models are tried if earlier ones fail or are slow.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite

# Groq (backup). Free key: https://console.groq.com/keys
# The free tier allows 8,000 tokens per minute, less than the system prompt, so Groq needs a paid plan.
GROQ_API_KEY=
# Comma-separated list; later models are tried if earlier ones fail or are slow.
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
